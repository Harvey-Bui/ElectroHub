# ---------------------------------------------------------------
# ElectroHub environment configuration
# Copy to `.env` in the repository root:  cp .env.example .env
# The server, the client (Vite) and Docker Compose all read this file.
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Set to true only when running behind a reverse proxy (uses X-Forwarded-For for client IPs)
TRUST_PROXY=false

# --- Security ---
# Signs the customer and admin cookies. REQUIRED in production (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Administrator created by `npm run admin:create` (password: 12+ characters).
# Only an scrypt hash is stored in Redis.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=8
# Failed admin logins allowed per IP per window before HTTP 429
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15

# --- Redis (primary database) ---
REDIS_URL=redis://localhost:6379
# Leave empty for local development; set for any shared environment
REDIS_PASSWORD=
# Namespace prefix applied to every key ElectroHub writes
REDIS_KEY_PREFIX=electrohub:
# --- Store rules ---
# Products at or below this stock level appear in inventory:low-stock
LOW_STOCK_THRESHOLD=5
# Idle shopping carts expire after this many days
CART_TTL_DAYS=30
# Orders below this subtotal pay the flat shipping rate
FREE_SHIPPING_THRESHOLD_CENTS=10000
SHIPPING_FLAT_CENTS=999

# Host port Docker Compose publishes Redis on
REDIS_PORT=6379

# --- Client (Vite: only VITE_* variables reach the browser) ---
# Leave empty to use the Vite dev-server proxy (/api -> server)
VITE_API_BASE_URL=
# Where the Vite dev-server proxies /api requests
VITE_DEV_API_PROXY_TARGET=http://localhost:4000
