# ---------------------------------------------------------------
# ElectroHub environment configuration
# Copy to `.env` in the repository root:  cp .env.example .env
# The server, the client (Vite) and Docker Compose all read this file.
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# --- Redis (primary database) ---
REDIS_URL=redis://localhost:6379
# Leave empty for local development; set for any shared environment
REDIS_PASSWORD=
# Namespace prefix applied to every key ElectroHub writes
REDIS_KEY_PREFIX=electrohub:
# Host port Docker Compose publishes Redis on
REDIS_PORT=6379

# --- Client (Vite: only VITE_* variables reach the browser) ---
# Leave empty to use the Vite dev-server proxy (/api -> server)
VITE_API_BASE_URL=
# Where the Vite dev-server proxies /api requests
VITE_DEV_API_PROXY_TARGET=http://localhost:4000
